--// CONST \\--
local F_NEWINST = 
	[[
%s["%s"] = Instance.new("%s", %s);
%s
%s
%s
]]; -- %s = Settings.RegName, %s = Id, %s = ClassName, %s = Parent, %s = Properties, %s = Attributes. % = Tags
