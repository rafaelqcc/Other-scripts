			Members = {"AutoSkin", "BindOffset", "Color", "DebugMode", "Enabled", "Order", "Puffiness", "ReferenceMeshContent", "ReferenceMeshId", "ReferenceOrigin", "ShrinkFactor"},
			Superclass = "BaseWrap",
		},
